BOT_TOKEN=put-your-telegram-bot-token-here

# Optional. Telegram user IDs that can open /admin. Use /id in a private chat with the bot.
ADMIN_USER_IDS=

# Optional. Hours from UTC: local time for scheduled events and night uploads. Default 3 (Moscow).
BOT_TZ_OFFSET=3

# Optional. Default: data/kartinkomet_v2.sqlite (or the Railway volume when
# RAILWAY_VOLUME_MOUNT_PATH is set).
# DATABASE_PATH=
