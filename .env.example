BOT_TOKEN=put-your-telegram-bot-token-here

# Optional. Telegram user IDs that can open /admin. Use /id in a private chat with the bot.
ADMIN_USER_IDS=

# Optional. Hours from UTC, used only for night-upload achievements. Default 3 (Moscow).
BOT_TZ_OFFSET=3

# Optional overrides. Default: data/kartinkomet_v2.sqlite and data/kartinkomet.sqlite
# (or the Railway volume when RAILWAY_VOLUME_MOUNT_PATH is set).
# DATABASE_PATH=
# LEGACY_DATABASE_PATH=
